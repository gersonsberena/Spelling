# Copy to .env and fill in. Never commit the real file — .gitignore covers .env*.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The service role key bypasses row-level security. It is required by the
# pipeline because RLS deliberately grants clients no write access to content
# tables. Server and CI only — never in the app, never in a browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cartesia ──────────────────────────────────────────────────────────────
# Used only by pipeline/tts/generate.mjs --apply and by the /tts Edge Function.
# Never ship this in the app bundle; the app fetches pre-rendered audio from
# storage and only ever talks to the Edge Function for uploaded words.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL_ID=sonic-english
CARTESIA_VERSION=2024-06-10

# ── Local database (supabase/local/verify.sh) ─────────────────────────────
PGHOST=/tmp
PGPORT=5433
PGUSER=postgres
